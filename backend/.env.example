# SentinelX Backend Environment Variables

# Application
APP_NAME=SentinelX
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default; swap to PostgreSQL via asyncpg URL in production)
DATABASE_URL=sqlite+aiosqlite:///./sentinelx.db

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NIST NVD API
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_RESULTS_PER_PAGE=2000
NVD_REQUEST_DELAY_SECONDS=0.6

# CISA KEV
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Shodan
SHODAN_API_KEY=

# Schedulers
NVD_INGEST_INTERVAL_MINUTES=10
KEV_INGEST_CRON_HOUR=0
TELEMETRY_CACHE_TTL_SECONDS=86400

# AI assistant (OpenAI or Anthropic — whichever is set wins)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# News feed
NEWSAPI_KEY=
NEWS_INGEST_INTERVAL_MINUTES=10
NEWS_RETENTION_HOURS=48
NEWS_RSS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/,https://krebsonsecurity.com/feed/,https://www.darkreading.com/rss.xml

# Initial Admin (created on startup if not present)
INITIAL_ADMIN_EMAIL=admin@sentinelx.io
INITIAL_ADMIN_PASSWORD=ChangeMe!2026
INITIAL_ADMIN_USERNAME=admin

# Email OTP (optional — leave SMTP_HOST empty to log codes to server logs instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
